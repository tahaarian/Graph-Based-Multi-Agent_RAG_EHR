# ============================================================
# EHR Graph-RAG environment configuration (Phase 0)
# Copy this file to .env and fill in real values. Never commit the actual .env file.
# NEVER commit the real `.env` file to git.
# ============================================================

# --- Neo4j (dynamic heterogeneous graph store) ---
# Bolt connection URI for your Neo4j instance.
NEO4J_URI=bolt://localhost:7687
# Username for the Neo4j database.
NEO4J_USER=neo4j
# Password for the Neo4j database (change this in your local .env).
NEO4J_PASSWORD=changeme

# --- Qdrant (vector store for semantic embeddings) ---
# REST/gRPC endpoint of the Qdrant service.
QDRANT_URL=http://localhost:6333
# Optional API key (leave empty for local unsecured deployments).
QDRANT_API_KEY=(empty

# --- LLM backend ---
# `local` uses a local GGUF model; switch to a hosted provider later if desired.
LLM_PROVIDER=local
# Path to the local instruction-tuned model weights (GGUF format).
LOCAL_LLM_MODEL_PATH=./models/llama-3.2-3b-instruct-q4.gguf

# --- Logging ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
